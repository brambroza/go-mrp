# Copy to .env.local (never commit). Values prefixed EXPO_PUBLIC_ are bundled into the app,
# so never put secrets here.
#
# Base URL of the API host, without /api/v1.
# On a real device use the LAN IP of the machine that runs the API, not localhost.
# HTTP is accepted only for local/private addresses; any other host must use HTTPS.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:5080
