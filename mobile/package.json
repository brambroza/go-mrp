    "@react-native/jest-preset": "^0.86.3",
    "@react-native/metro-config": "0.86.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.13",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
