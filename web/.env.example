# Copy to .env.local. No secrets belong in this file or in the repository.

# Base URL of the .NET API as seen from the Next.js SERVER (route handlers under /api/auth and the
# data proxy under /api/v1). No trailing slash, no /api/v1 suffix. Read at runtime.
API_BASE_URL=http://localhost:5080

# Base URL of the .NET API as seen from the BROWSER. Leave EMPTY (recommended): data calls then go
# to the same-origin proxy /api/v1/* of this app and need no CORS. Set it only to let the browser
# call the API directly; the API must then allow this app's origin in Cors:Origins.
# Inlined at build time.
NEXT_PUBLIC_API_BASE_URL=

# Public origin(s) of this app, comma separated, accepted by the CSRF origin check in addition to
# the request's own Host header. Needed only behind a proxy that rewrites Host.
APP_ORIGIN=

# "true"/"false" to force the Secure attribute of cookies. Default: true in production.
# Set to false only to run a production build over plain http on localhost in Safari.
COOKIE_SECURE=
