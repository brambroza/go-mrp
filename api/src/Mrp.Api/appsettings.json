{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "AppRole": "mrp_app"
  },
  "Jwt": {
    "Issuer": "mrp-api",
    "Audience": "mrp-clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Cors": {
    "Origins": []
  },
  "RateLimit": {
    "AuthPerMinute": 20
  }
}
